rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Allow respondents to create & update their own Base64 questionnaire entries
    match /respondents/{respondentId} {
      // Any technician / user can create and update respondent records
      allow create: if true;
      allow read, update: if true;
      
      // Only authenticated admin users can delete respondent data
      allow delete: if request.auth != null;
    }

    // Default rule: Require Firebase Auth for all other admin paths
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
