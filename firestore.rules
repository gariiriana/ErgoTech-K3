rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Allow respondents collection (Public write/read for web respondents)
    match /respondents/{respondentId} {
      allow read, write: if true;
    }

    // Allow admins collection (Activity logging)
    match /admins/{adminId} {
      allow read, write: if true;
    }

    // Fallback rule for any other collection
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
